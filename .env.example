# OpenAPI 契约智能生成 Agent —— 环境变量示例
#
# 用法：复制为 .env 后填入真实值，然后执行 `python scripts/run_web.py`
#      .env 已在 .gitignore 中，不会被提交。

# ===== 必填：大模型服务（兼容 OpenAI 协议）=====
OPENAPI_AGENT_BASE_URL=https://api.openai.com/v1
OPENAPI_AGENT_API_KEY=sk-在这里填入你的密钥
OPENAPI_AGENT_MODEL=gpt-4o-mini

# ===== 可选：请求与 Token 控制 =====
# OPENAPI_AGENT_LLM_TIMEOUT=60
# OPENAPI_AGENT_MODEL_MAX_CONTEXT=128000
# OPENAPI_AGENT_TOTAL_MATERIAL_TOKEN_LIMIT=100000
# OPENAPI_AGENT_PER_CHUNK_TOKEN_LIMIT=4000
# OPENAPI_AGENT_PROMPT_RESERVE_RATIO=0.25
# OPENAPI_AGENT_ENABLE_CONTEXT_TRUNCATE=false

# ===== 可选：入参限制 =====
# OPENAPI_AGENT_USER_INSTRUCTION_MAX_LEN=1000
# OPENAPI_AGENT_MAX_UPLOAD_FILES=10
# OPENAPI_AGENT_MAX_FILE_SIZE_MB=20
# OPENAPI_AGENT_MIN_CONTENT_LEN=20

# ===== 可选：分片与任务 =====
# OPENAPI_AGENT_CHUNK_SIZE=1500
# OPENAPI_AGENT_CHUNK_OVERLAP=150
# OPENAPI_AGENT_ASYNC_WORKER_TIMEOUT=300

# ===== 可选：默认生成行为 =====
# OPENAPI_AGENT_GENERATE_MODE=strict
# OPENAPI_AGENT_OPENAPI_VERSION=3.0.3

# ===== 可选：上传素材临时目录根路径（容器/沙箱建议挂载可写卷）=====
# OPENAPI_AGENT_TEMP_ROOT=
